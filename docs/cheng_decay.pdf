<script type="text/javascript">
    $(function () {
        var tabContainers = $('div.tabs__container > div');
        var hash = window.location.hash;
        if (!hash || hash == '#') {    hash = $('.tabs__tabs li').first().find('a').attr('href'); }
        $(function () {
                tabContainers.hide();
                tabContainers.filter(hash).show();
                $('ul.tabs__tabs a').removeClass('selected');
                $('ul.tabs__tabs li').removeClass('is-active');
                $('ul.tabs__tabs a[href="' + hash + '"]').addClass('selected').parent().addClass('is-active');
                return false;
        });
        
        $('ul.tabs__tabs a').click(function () {
            tabContainers.hide();
            tabContainers.filter(this.hash).show();
            $('ul.tabs__tabs a').removeClass('selected');
            $('ul.tabs__tabs li').removeClass('is-active');
            $(this).addClass('selected').parent().addClass('is-active');
            return false;
        });
        
        $("ul.tabs__tabs").each(function() {if(!$(this).has("li").length)$("div.tabs").hide();});
        
        $("a[href=\'qmroHref\']").contents().unwrap();
        $("a[href=\'authorUrl\']").contents().unwrap();
        $("span.doi:contains(doi)").html("");
        $("span.nameOfConference:contains(nameOfConference)").html("");
        $("span.authorsText:contains(authorsText)").html("");
        $("span.publicationYear:contains(publicationYear)").html("");
        $("span.qmroHref:contains(qmroHref)").html("");
        $("span.small:contains(publicationDate)").html("");
        $("span.journal:contains(journal)").html("");
        $("span.authorUrl:contains(authorUrl)").html("");
    });
    
</script>

